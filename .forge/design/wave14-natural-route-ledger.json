  "koEnCommonJudgment": {
    "sameNumericContract": true,
    "sameRouteIds": true,
    "sameThresholds": true,
    "meaningCheck": "In the active locale, the player explains the same missing resource, prerequisite and result cause without requiring word-for-word translation.",
    "qpsLongHumanEvidenceAllowed": false,
    "rules": [
      "Never loosen a resource, time, day, signal, bag or result acceptance threshold for one locale.",
      "Treat a KO/EN meaning mismatch as localization or discovery evidence before balance.",
      "Do not combine locale ratings or comprehension with automation."
    ]
  },
  "decisionGate": {
    "singleOwnerRunCanChangeBalance": false,
    "minimumBeforeProposal": {
      "validHumanSessions": 6,
      "ko": 3,
      "en": 3,
      "sameResourceCauseSessions": 2,
      "discoveryAndComprehensionMustPass": true
    },
    "triageOrder": [
      "technical_and_log_integrity",
      "discovery_prompt_and_locale_meaning",
      "route_focus_and_navigation",
      "twenty_minute_pacing",
      "one_balance_axis_proposal"
    ],
    "oneAxisOptions": [
      "RESOURCE_INFLOW",
      "INVESTMENT_COST",
      "SURVIVAL_PRESSURE"
    ],
    "calendarChangeAllowedByThisGate": false,
    "automaticChange": false,
    "rerunRequirement": "Use the same four route IDs and the same KO/EN judgment after changing exactly one axis in a new build."
  },
  "decisions": [
    {
      "id": "decision.wave14.geometry-aware-ledger",
      "decision": "Only node bundles that fit actual coordinates, barrier access, yields, and 4/6-slot stacking count as natural-route specifications."
    },
    {
      "id": "decision.wave14.prescribed-route-not-discovery",
      "decision": "The four directed routes are owner/QA validation and never count as naive first-user discovery sessions."
    },
    {
      "id": "decision.wave14.auto-human-boundary",
      "decision": "JSONL state and stable events prove numeric transitions; intention, understanding, loot choice, and visible module commitment remain human observations."
    },
    {
      "id": "decision.wave14.one-axis-change",
      "decision": "Even after the six-session threshold, open at most one balance-axis proposal and never mutate values automatically."
    }
  ],
  "openQuestions": [
    "Can each directed natural route finish within 20 minutes in the actual Windows Development Build?",
    "How far do human movement and popup dwell times spread Energy and Daylight from the diagnostic references?",
    "Should a later implementation add a dedicated module.committed event and committedModuleId to the fingerprint?"
  ],
  "blockers": [

  - m_Id: 197482050207744
    m_Localized: "\uC2E0\uD6381 \xB7 \uC791\uC5C5\uB300:{0}\n\uB098\uBB34:{1}/2 \uD45C\uB958\uBB3C:{2}/2"
    m_Metadata:
      m_Items:
      - rid: 828367071277219866
  - m_Id: 197482096345088
    m_Localized: "\uC2E0\uD6382 \xB7 \uBC27\uC904:{0}\n\uB098\uBB34:{1}/2 \uD45C\uB958\uBB3C:{2}/2"
    m_Metadata:
      m_Items:
      - rid: 828367071277219866
  - m_Id: 197482096345089
    m_Localized: "\uB3CC\uB3C4\uB07C\uB85C \uC7A5\uBCBD \uC81C\uAC70"
    m_Metadata:
      m_Items: []
  - m_Id: 197482096345090
    m_Localized: "\uB3CC\uB3C4\uB07C \uD544\uC694\n\uB369\uAD74\xB7\uB098\uBB34 \uC7A5\uBCBD"
    m_Metadata:
      m_Items: []
  - m_Id: 197482096345091
    m_Localized: "1\uB2E8\uACC4\uC5D0\uB294 \uC791\uC5C5\uB300\uAC00 \uD544\uC694\uD558\uB2E4.
      \uD604\uC7AC \uC791\uC5C5\uB300\uAC00 \uC5C6\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 197482096345092
    m_Localized: "\uB098\uBB34\uAC00 \uBD80\uC871\uD558\uB2E4. \uD604\uC7AC {0}/2."
    m_Metadata:
      m_Items:
      - rid: 828367071277219866
  - m_Id: 197482096345093
    m_Localized: "\uD45C\uB958\uBB3C\uC774 \uBD80\uC871\uD558\uB2E4. \uD604\uC7AC
      {0}/2."
    m_Metadata:
      m_Items:
      - rid: 828367071277219866
  - m_Id: 197482100539392
    m_Localized: "\uB369\uAD74\uACFC \uB098\uBB34\uAC00 \uAE38\uC744 \uB9C9\uB294\uB2E4.
      \uB3CC\uB3C4\uB07C\uB85C \uC7A5\uBCBD\uC744 \uC81C\uAC70\uD574\uC57C \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 231960655151104
    m_Localized: "{0} \xB7 A/D \uC774\uB3D9 \xB7 \uD574\uC548 \uC790\uB3D9 \uC218\uC601
      \xB7 Space \uC810\uD504 \xB7 E \uC218\uC0C9 \xB7 R \uADC0\uD658\n\uAC00\uBC29
      \uAD50\uCCB4 1\u2013{1} \xB7 Esc \uD3EC\uAE30 \xB7 F1 \uC5B8\uC5B4"
    m_Metadata:
      m_Items:
      - rid: 828367071277219866
  - m_Id: 231960692899840
    m_Localized: "{0} \xB7 \uC2A4\uD2F1 \uC774\uB3D9 \xB7 \uD574\uC548 \uC790\uB3D9
      \uC218\uC601 \xB7 A \uC810\uD504 \xB7 X \uC218\uC0C9 \xB7 B \uADC0\uD658\n\uAD50\uCCB4
      \uCC3D \uBC29\uD5A5\uD0A4+A ({1}\uCE78) \xB7 B \uD3EC\uAE30 \xB7 Y \uC5B8\uC5B4"
    m_Metadata:
      m_Items:
      - rid: 828367071277219866
  - m_Id: 231960692899841
    m_Localized: "{0}. \uC7A0\uAE40"
    m_Metadata:
      m_Items:
      - rid: 828367071277219866
  - m_Id: 231960692899842
    m_Localized: "\uAC00\uBC29 \uD655\uC7A5 {0}\u2192{1}\n\uC791\uC5C5\uB300 \uD544\uC694"
    m_Metadata:
      m_Items:
      - rid: 828367071277219866
  - m_Id: 231960692899843
    m_Localized: "\uAC00\uBC29 \uD655\uC7A5 {0}\u2192{1}\n\uB098\uBB34 {2}/{3} \xB7
      \uD45C\uB958\uBB3C {4}/{5}"
    m_Metadata:
      m_Items:
      - rid: 828367071277219866
  - m_Id: 231960692899844
    m_Localized: "[\uC644\uB8CC] \uAC00\uBC29 {0}\uCE78"
    m_Metadata:
      m_Items:
      - rid: 828367071277219866
  - m_Id: 231960701288448
    m_Localized: "\uAC00\uBC29 \uD655\uC7A5\uC740 \uBCA0\uC774\uC2A4\uCEA0\uD504\uC5D0\uC11C\uB9CC
      \uD560 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 231960701288449
    m_Localized: "\uAC00\uBC29\uC744 \uD655\uC7A5\uD558\uB824\uBA74 \uBA3C\uC800
      \uC791\uC5C5\uB300\uAC00 \uD544\uC694\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 231960701288450
    m_Localized: "\uB098\uBB34\uC640 \uD45C\uB958\uBB3C\uC774 \uBD80\uC871\uD558\uB2E4.
      \uD604\uC7AC \uB098\uBB34 {0}/2, \uD45C\uB958\uBB3C {1}/1."
    m_Metadata:
      m_Items:
      - rid: 828367071277219866
  - m_Id: 231960701288451
    m_Localized: "\uAC00\uBC29 \uD655\uC7A5\uC6A9 \uB098\uBB34\uAC00 \uBD80\uC871\uD558\uB2E4.
      \uD604\uC7AC {0}/2."
    m_Metadata:
      m_Items:
      - rid: 828367071277219866
  - m_Id: 231960701288452
    m_Localized: "\uAC00\uBC29 \uD655\uC7A5\uC6A9 \uD45C\uB958\uBB3C\uC774 \uBD80\uC871\uD558\uB2E4.
      \uD604\uC7AC {0}/1."
    m_Metadata:
      m_Items:
      - rid: 828367071277219866
  - m_Id: 231960701288453
    m_Localized: "\uAC00\uBC29 \uD655\uC7A5 \uC644\uB8CC. \uC774\uC81C \uC5EC\uC12F
      \uCE78\uC744 \uCC44\uC6B8 \uAC71\uC815\uC774 \uC0DD\uACBC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 231960701288454
    m_Localized: "\uAC00\uBC29\uC740 \uC774\uBBF8 6\uCE78\uC73C\uB85C \uD655\uC7A5\uD588\uB2E4.
      \uB450 \uBC88 \uAFF0\uB9E8\uB2E4\uACE0 \uB354 \uB298\uC9C0\uB294 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 250514246975488
    m_Localized: "\uC77C\uBC18 \uC124\uBE44 \uAD6C\uC5ED\n0.5m \uBC14\uB2E5 \uC2A4\uB0C5"
    m_Metadata:
      m_Items: []
  - m_Id: 250514288918528
    m_Localized: "\uBE57\uBB3C\uBC1B\uC774 \uC804\uC6A9\n\uD0C1 \uD2B8\uC778 \uD558\uB298
      \uAD6C\uC5ED"
    m_Metadata:
      m_Items: []
  - m_Id: 250514288918529
    m_Localized: "{0}\uC740(\uB294) \uC9C0\uC815\uB41C \uD638\uD658 \uBC14\uB2E5\uC5D0\uB9CC
      \uB193\uC744 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items:
      - rid: 828367071277219866
  - m_Id: 250514288918530
    m_Localized: "{0}m \uC548\uC5D0 \uC0AC\uC6A9\uD560 \uC124\uBE44\uAC00 \uC5C6\uB2E4.
      \uAE40\uC528\uAC00 \uC870\uAE08 \uB354 \uAC00\uAE4C\uC774 \uAC00\uC57C \uD55C\uB2E4."
    m_Metadata:
      m_Items:
      - rid: 828367071277219866
  - m_Id: 250514288918531
    m_Localized: "{0} \uC0AC\uC6A9\xB7\uC7AC\uBC30\uCE58\uB294 {1}m \uC548\uC5D0\uC11C\uB9CC
      \uAC00\uB2A5\uD558\uB2E4."
    m_Metadata:
      m_Items:
      - rid: 828367071277219866
  - m_Id: 250514288918532
    m_Localized: "\uAD6C\uC870 \uC2E0\uD638 \uC790\uC6D0 \uD22C\uC785\uC740 \uC2E0\uD638\uB300
      {0}m \uC548\uC5D0\uC11C\uB9CC \uAC00\uB2A5\uD558\uB2E4."
    m_Metadata:
      m_Items:
      - rid: 828367071277219866
  - m_Id: 250514288918533
    m_Localized: "\uC791\uC5C5\uB300 \uC0AC\uC6A9 \uAC00\uB2A5. \uAC00\uAE4C\uC774
      \uC120 \uCC44 \uC5F0\uAD6C\xB7\uC81C\uC791 \uD589\uB3D9\uC744 \uACE0\uB974\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 250514288918534
    m_Localized: "\uBAA8\uB2E5\uBD88 \uD734\uC2DD \uC900\uBE44 \uC644\uB8CC. \uC624\uB298
      \uC815\uC0B0\uC5D0 \uBAA8\uB2E5\uBD88 \uBCF4\uB108\uC2A4\uAC00 \uC801\uC6A9\uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 250514288918535
    m_Localized: "\uBE57\uBB3C\uC744 \uBC1B\uC544 \uB450\uC5C8\uB2E4. \uC624\uB298
      \uC815\uC0B0\uC5D0 \uBE57\uBB3C\uBC1B\uC774 \uBCF4\uB108\uC2A4\uAC00 \uC801\uC6A9\uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 270049469513728
    m_Localized: "{0} \xB7 \uBC29\uD5A5\uD0A4\uB85C \uD589\uB3D9 \uC120\uD0DD \xB7
      Enter \uD655\uC778\nEsc \uCDE8\uC18C \xB7 \uC774\uB3D9 \uC7A0\uAE40 \xB7 F1
      \uC5B8\uC5B4"
    m_Metadata:
      m_Items:
      - rid: 828367071277219866
  - m_Id: 270049511456768
    m_Localized: "{0} \xB7 \uBC29\uD5A5 \uD328\uB4DC\uB85C \uD589\uB3D9 \uC120\uD0DD
      \xB7 A \uD655\uC778\nB \uCDE8\uC18C \xB7 \uC774\uB3D9 \uC7A0\uAE40 \xB7 Y \uC5B8\uC5B4"
    m_Metadata:
      m_Items:

  m_TableData:
  - m_Id: 796114944
    m_Localized: "\uBCA0\uC774\uC2A4\uCEA0\uD504 \xB7 \uC81C\uC791 / \uAC74\uC124
      / \uC5F0\uAD6C"
    m_Metadata:
      m_Items: []
  - m_Id: 888389632
    m_Localized: "\uB2E4\uC2DC \uC2DC\uC791"
    m_Metadata:
      m_Items: []
  - m_Id: 892583936
    m_Localized: "\uD55C\uAD6D\uC5B4 \u2192 English"
    m_Metadata:
      m_Items: []
  - m_Id: 892583937
    m_Localized: "English \u2192 \uD55C\uAD6D\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 892583938
    m_Localized: "\uADC0\uD658 \uD6C4 \uC815\uBE44"
    m_Metadata:
      m_Items: []
  - m_Id: 892583939
    m_Localized: "\uCEA0\uD504 \uC900\uBE44"
    m_Metadata:
      m_Items: []
  - m_Id: 892583940
    m_Localized: "\uC595\uC740 \uC5F0\uC548 \uC218\uC601"
    m_Metadata:
      m_Items: []
  - m_Id: 892583941
    m_Localized: "\uC12C \uC218\uC0C9"
    m_Metadata:
      m_Items: []
  - m_Id: 892583942
    m_Localized: "\uACB0\uACFC"
    m_Metadata:
      m_Items: []
  - m_Id: 892583943
    m_Localized: "DAY {0}/{1} \xB7 {2}\n\uD5C8\uAE30 {3} | \uCCB4\uB825 {4}"
    m_Metadata:
      m_Items:
      - rid: 828367071277219866
  - m_Id: 896778240
    m_Localized: "DAY {0}/{1} \xB7 {2}\n\uD5C8\uAE30 {3} | \uCCB4\uB825 {4} | \uC77C\uAD11
      {5}"
    m_Metadata:
      m_Items:
      - rid: 828367071277219866
  - m_Id: 896778241
    m_Localized: "\uB098\uBB34 {0}   \uB3CC {1}   \uC2DD\uB7C9 {2}   \uD45C\uB958\uBB3C
      {3}\n\uC2E0\uD638\uB300 {4}/2   \uB3C4\uB07C {5}   \uBC27\uC904 {6}"
    m_Metadata:
      m_Items:
      - rid: 828367071277219866
  - m_Id: 896778242
    m_Localized: "{0} \xB7 \uB9C8\uC6B0\uC2A4 \uB610\uB294 \uC2A4\uD2F1 \uC88C\uC6B0
      \uBC30\uCE58 \xB7 \uD074\uB9AD/Enter/A \uD655\uC815 \xB7 \uC6B0\uD074\uB9AD/Esc/B
      \uCDE8\uC18C \xB7 F1/Y \uC5B8\uC5B4"
    m_Metadata:
      m_Items:
      - rid: 828367071277219866
  - m_Id: 896778243
    m_Localized: "{0} \xB7 \uBC84\uD2BC\uC744 \uC120\uD0DD\uD574 \uCEA0\uD504\uB97C
      \uC815\uBE44\uD558\uC138\uC694 \xB7 \uAC74\uC124\uB41C \uC77C\uBC18 \uC124\uBE44\uB294
      \uBB34\uB8CC \uC7AC\uBC30\uCE58 \xB7 F1/Y \uC5B8\uC5B4"
    m_Metadata:
      m_Items:
      - rid: 828367071277219866
  - m_Id: 896778244
    m_Localized: "{0} \xB7 A/D \uB610\uB294 \uC2A4\uD2F1 \uC774\uB3D9 \xB7 \uD574\uC548\uC5D0\uC11C
      \uC790\uB3D9 \uC218\uC601 \xB7 Space/A \uC810\uD504 \xB7 E/X \uC218\uC0C9 \xB7
      R/B \uADC0\uD658 \xB7 F1/Y \uC5B8\uC5B4"
    m_Metadata:
      m_Items:
      - rid: 828367071277219866
  - m_Id: 896778245
    m_Localized: "\uCEA0\uD504 \uCC3D\uACE0\n(\uC218\uC0C9 \uC911\uC5D0\uB294 4\uCE78
      \uAC00\uBC29)"
    m_Metadata:
      m_Items: []
  - m_Id: 900972544
    m_Localized: "\uAC00\uBC29\uC774 \uAF49 \uCC3C\uC2B5\uB2C8\uB2E4\n\uBC84\uB9B4
      \uC2AC\uB86F\uC744 \uC120\uD0DD"
    m_Metadata:
      m_Items: []
  - m_Id: 900972545
    m_Localized: "\uC218\uC0C9 \uAC00\uBC29 4\uCE78\n\uD55C \uBB36\uC74C \uCD5C\uB300
      2\uAC1C"
    m_Metadata:
      m_Items: []
  - m_Id: 900972546
    m_Localized: "{0}. \uBE48\uCE78"
    m_Metadata:
      m_Items:
      - rid: 828367071277219866
  - m_Id: 900972547
    m_Localized: "{0}. {1} \xD7{2}"
    m_Metadata:
      m_Items:
      - rid: 828367071277219866
  - m_Id: 900972548
    m_Localized: "\u2194 \uBAA8\uB2E5\uBD88 \uBB34\uB8CC \uC7AC\uBC30\uCE58"
    m_Metadata:
      m_Items: []
  - m_Id: 900972549
    m_Localized: "\uBAA8\uB2E5\uBD88 \uAC74\uC124  \uB098\uBB342\xB7\uB3CC1"
    m_Metadata:
      m_Items: []
  - m_Id: 900972550
    m_Localized: "\u2194 \uC791\uC5C5\uB300 \uBB34\uB8CC \uC7AC\uBC30\uCE58"
    m_Metadata:
      m_Items: []
  - m_Id: 900972551
    m_Localized: "\uC791\uC5C5\uB300 \uAC74\uC124  \uB098\uBB342\xB7\uD45C\uB958\uBB3C1"
    m_Metadata:
      m_Items: []
  - m_Id: 900972552
    m_Localized: "\u2194 \uBE57\uBB3C\uBC1B\uC774 \uBB34\uB8CC \uC7AC\uBC30\uCE58"
    m_Metadata:
      m_Items: []
  - m_Id: 900972553
    m_Localized: "\uBE57\uBB3C\uBC1B\uC774  \uB098\uBB342\xB7\uB3CC1\xB7\uD45C\uB958\uBB3C1"
    m_Metadata:
      m_Items: []

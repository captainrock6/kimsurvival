    m_Metadata:
      m_Items:
      - rid: 828367071277219866
  - m_Id: 900972545
    m_Localized: "\uC218\uC0C9 \uAC00\uBC29 {0}/{1}\n\uD55C \uBB36\uC74C \uCD5C\uB300
      2\uAC1C"
    m_Metadata:
      m_Items:

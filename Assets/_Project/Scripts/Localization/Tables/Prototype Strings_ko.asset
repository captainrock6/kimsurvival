    m_Localized: "{0}\uC5D0 \uD22C\uC785\uD560 \uC790\uC6D0\uC774 \uBD80\uC871\uD558\uB2E4."
    m_Metadata:
      m_Items:
      - rid: 828367071277219866
  - m_Id: 747417803931653
    m_Localized: 부싯돌과 나무 12·섬유 2·연료 2를 두 단계로 넣고, 맑은 바람에 가시성을 확인한다.
    m_Metadata:
      m_Items: []
  - m_Id: 747417803931654
    m_Localized: 무전기·전자기판·트랜지스터와 전자 6·전선 6·금속 4로 수리한 뒤 깨끗한 주파수를 찾는다.
    m_Metadata:
      m_Items: []
  - m_Id: 747417803931655
    m_Localized: "\uC218\uD3C9\uC120 \uB108\uBA38\uB85C"
    m_Metadata:
      m_Items: []
  - m_Id: 747417803931656
    m_Localized: "\uC9C1\uC811 \uC5EE\uC740 \uB5CF\uBAA9\uC73C\uB85C \uC870\uB958\uB97C
      \uD0C0\uACE0 \uC12C\uC744 \uBC97\uC5B4\uB0AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 747417803931657
    m_Localized: "\uBC14\uB2E4\uB294 \uBCBD\uC774 \uC544\uB2C8\uB77C \uAE38\uC77C\uC9C0\uB3C4
      \uBAA8\uB978\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 747417803931658
    m_Localized: "\uC5F0\uAE30\uB294 \uB2F5\uC744 \uC548\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 747417803931659
    m_Localized: "\uBA70\uCE60 \uC9C0\uD0A8 \uC5F0\uAE30\uAC00 \uB9C8\uCE68\uB0B4
      \uBC30\uB97C \uBD88\uB800\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 747417803931660
    m_Localized: "\uBA40\uB9AC\uC11C\uB3C4 \uBCF4\uC774\uB294 \uD558\uB8E8\uB97C
      \uB9CC\uB4E4\uC5B4 \uBCF4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 747417803931661
    m_Localized: "\uC5EC\uAE30\uB294 \uAE40\uC528, \uC751\uB2F5\uD558\uB77C"
    m_Metadata:
      m_Items: []
  - m_Id: 747417803931662
    m_Localized: "\uC7A1\uC74C \uC18D \uD55C \uBB38\uC7A5\uC774 \uC704\uCE58\uB97C
      \uC138\uC0C1\uC5D0 \uC54C\uB838\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 747417803931663
    m_Localized: "\uC7A1\uC74C\uB3C4 \uC624\uB798 \uB4E4\uC73C\uBA74 \uBB38\uC7A5\uC774
      \uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 747417803931664
    m_Localized: "\uB531 \uD55C \uBC1C"
    m_Metadata:
      m_Items: []
  - m_Id: 747417803931665
    m_Localized: "\uC720\uC77C\uD55C \uC870\uBA85\uD0C4\uC744 \uC815\uD655\uD55C
      \uC21C\uAC04\uC5D0 \uBC1C\uC0AC\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 747417803931666
    m_Localized: "\uAE30\uD68C\uAC00 \uC62C \uB54C\uAE4C\uC9C0 \uD55C \uBC1C\uC744
      \uC544\uAEF4\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 747417803931667
    m_Localized: "\uBD88\uC774 \uCF1C\uC9C4 \uC0B0\uAF2D\uB300\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 747417803931668
    m_Localized: "\uBCF5\uAD6C\uD55C \uC911\uACC4\uC18C\uAC00 \uC12C\uC744 \uC9C0\uB3C4
      \uC704 \uC810\uC73C\uB85C \uB9CC\uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 747417803931669
    m_Localized: "\uAC00\uC7A5 \uB192\uC740 \uACF3\uC758 \uC8FD\uC740 \uBD88\uC744
      \uAE68\uC6CC\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 747417803931670
    m_Localized: "\uCF54\uCF54\uB11B \uD574\uAD70"
    m_Metadata:
      m_Items: []
  - m_Id: 747417803931671
    m_Localized: "\uCF54\uCF54\uB11B \uD654\uBB3C\uC774 \uB5CF\uBAA9\uBCF4\uB2E4
      \uBA3C\uC800 \uC720\uBA85\uD574\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 747417808125952
    m_Localized: "\uBC30\uC5D0\uB294 \uD3C9\uD615\uCD94\uAC00 \uD544\uC694\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 747417808125953
    m_Localized: "\uBB34\uC778\uB3C4 \uB9DB\uC9D1"
    m_Metadata:
      m_Items: []
  - m_Id: 747417808125954
    m_Localized: "\uAD6C\uC870\uB300\uAC00 \uC804\uC124\uC758 \uBC14\uBE44\uD050
      \uC5F0\uAE30 \uC18C\uBB38\uC744 \uB530\uB77C\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 747417808125955
    m_Localized: "\uAD6C\uC870 \uC2E0\uD638\uAC00 \uB108\uBB34 \uB9DB\uC788\uC5B4
      \uBCF4\uC77C \uC218\uB3C4 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 747417808125956
    m_Localized: "\uBB34\uC778\uB3C4 FM"
    m_Metadata:
      m_Items: []
  - m_Id: 747417808125957
    m_Localized: "\uAD6C\uC870 \uC694\uCCAD \uC0AC\uC774\uC758 \uC120\uACE1\uC774
      \uCCAD\uCDE8\uC790\uB97C \uB9CC\uB4E4\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 747417808125958
    m_Localized: "\uC751\uB2F5\uC774 \uC5C6\uC73C\uBA74 \uBC29\uC1A1\uC774\uB77C\uB3C4
      \uD574 \uBCF4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 747417808125959
    m_Localized: "\uB300\uB0AE\uC758 \uBD88\uAF43\uB180\uC774"
    m_Metadata:
      m_Items: []
  - m_Id: 747417808125960

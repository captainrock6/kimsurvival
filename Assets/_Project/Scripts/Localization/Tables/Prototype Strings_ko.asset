    m_Metadata:
      m_Items: []
  - m_Id: 349680612655104
    m_Localized: "\uC774 \uC5F0\uACB0 \uC2AC\uB86F\uC5D0\uC11C \uBC29 \uD655\uC7A5
      \uD6C4\uBCF4\uB97C \uBBF8\uB9AC \uBCF8\uB2E4. \uD655\uC815 \uBE44\uC6A9\uC740

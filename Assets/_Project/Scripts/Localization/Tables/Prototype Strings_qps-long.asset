      m_Items: []
  - m_Id: 1102836460142609
    m_Localized: "\u27E6Find the protected sailcloth through eligible coastal searches.\xE1\xE9\xED\xF3\xFA\xFC\xF1\xBF\xA1\xE1\xE9\xED\xF3\xFA\xFC\xF1\xBF\xA1\xE1\xE9\xED\xF3\xFA\xFC\u27E7"
    m_Metadata:
      m_Items: []
  - m_Id: 1102836460142610
    m_Localized: "\u27E6Not enough resources for this raft action.\xE1\xE9\xED\xF3\xFA\xFC\xF1\xBF\xA1\xE1\xE9\xED\xF3\xFA\xFC\u27E7"
    m_Metadata:
      m_Items: []
  - m_Id: 1102836460142611
    m_Localized: "\u27E6Raft stage committed ({0}/{1}). Completed stages are preserved.\xE1\xE9\xED\xF3\xFA\xFC\xF1\xBF\xA1\xE1\xE9\xED\xF3\xFA\xFC\xF1\xBF\xA1\xE1\xE9\xED\xF3\xFA\xFC\u27E7"
    m_Metadata:
      m_Items:
      - rid: 828367092230914048
  - m_Id: 1102836460142612
    m_Localized: "\u27E6Launch confirmation armed. Check the weather and current
      before committing.\xE1\xE9\xED\xF3\xFA\xFC\xF1\xBF\xA1\xE1\xE9\xED\xF3\xFA\xFC\xF1\xBF\xA1\xE1\xE9\xED\xF3\xFA\xFC\xF1\xBF\xA1\xE1\u27E7"
    m_Metadata:
      m_Items: []
  - m_Id: 1102836460142613
    m_Localized: "\u27E6The launch window failed. One attempt cost was spent; all
      stages and sailcloth remain.\xE1\xE9\xED\xF3\xFA\xFC\xF1\xBF\xA1\xE1\xE9\xED\xF3\xFA\xFC\xF1\xBF\xA1\xE1\xE9\xED\xF3\xFA\xFC\xF1\xBF\xA1\xE1\xE9\xED\xF3\xFA\xFC\u27E7"
    m_Metadata:
      m_Items: []
  - m_Id: 1102836460142614
    m_Localized: "\u27E6Retry is ready. Recheck the launch window.\xE1\xE9\xED\xF3\xFA\xFC\xF1\xBF\xA1\xE1\xE9\xED\xF3\xFA\xFC\u27E7"
    m_Metadata:
      m_Items: []
  - m_Id: 1102836460142615
    m_Localized: "\u27E6The raft caught the outbound current. Escape resolved once.\xE1\xE9\xED\xF3\xFA\xFC\xF1\xBF\xA1\xE1\xE9\xED\xF3\xFA\xFC\xF1\xBF\xA1\xE1\xE9\xED\xF3\u27E7"

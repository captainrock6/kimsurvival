      m_Items: []
  - m_Id: 1102836460142608
    m_Localized: "\u27E6A rope is required to rig the sail.\xE1\xE9\xED\xF3\xFA\xFC\xF1\xBF\xA1\xE1\xE9\xED\u27E7"

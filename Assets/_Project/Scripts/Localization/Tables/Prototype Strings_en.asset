  - m_Id: 197482050207744
    m_Localized: 'Signal 1 Workbench:{0}

      Wood:{1}/2 Salvage:{2}/2'
    m_Metadata:
      m_Items:
      - rid: 828367071277219867
  - m_Id: 197482096345088
    m_Localized: 'Signal 2 Rope:{0}

      Wood:{1}/2 Salvage:{2}/2'
    m_Metadata:
      m_Items:
      - rid: 828367071277219867
  - m_Id: 197482096345089
    m_Localized: Clear Barrier with Stone Axe
    m_Metadata:
      m_Items: []
  - m_Id: 197482096345090
    m_Localized: 'Stone Axe Required

      Vine & Wood Barrier'
    m_Metadata:
      m_Items: []
  - m_Id: 197482096345091
    m_Localized: Stage 1 requires a workbench. No workbench is available.
    m_Metadata:
      m_Items: []
  - m_Id: 197482096345092
    m_Localized: 'Not enough wood. Current: {0}/2.'
    m_Metadata:
      m_Items:
      - rid: 828367071277219867
  - m_Id: 197482096345093
    m_Localized: 'Not enough salvage. Current: {0}/2.'
    m_Metadata:
      m_Items:
      - rid: 828367071277219867
  - m_Id: 197482100539392
    m_Localized: Vines and wood block the path. Clear the barrier with a stone axe.
    m_Metadata:
      m_Items: []
